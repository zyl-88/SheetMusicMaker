  "segments": [],
  "special": {
    "split_of": "F7",
    "rationale": "F7 只有 5.3s，librosa 节拍检测退化为 Beats=1、BPM 117.5（真值 100），量化网格错位会把 0.6s 的旋律音切成 1/16 碎片。本样本把同一动机重复 5 遍到 ~24s，用于在节拍可检测的前提下单独判断“人声路径的音高与数量是否可用”；原 F7 保留作短片长历史对照。",
    "decided_at": "2026-11-07",
    "decided_by": "验收方（独立验收）"
  },
